rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function hasOnly(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    match /profile/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if hasOnly([
        "name", "email", "organisation", "subject", "message",
        "read", "archived", "createdAt", "updatedAt"
      ]) && request.resource.data.read == false
        && request.resource.data.archived == false;
      allow read, update, delete: if isAdmin();
    }

    match /resumeRequests/{requestId} {
      allow create: if hasOnly([
        "fullName", "email", "organisation", "jobTitle", "reason",
        "linkedinUrl", "consent", "status", "createdAt", "updatedAt"
      ]) && request.resource.data.status == "Pending";
      allow read, update, delete: if isAdmin();
    }

    match /resumeAccessTokens/{tokenId} {
      allow read, write: if isAdmin();
    }
  }
}
